# Virtualenv - 7.5GB of torch/CUDA wheels, rebuild with:
#   uv venv --python 3.12
#   uv pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu128
#   uv pip install whisperx
.venv/

__pycache__/
*.py[cod]

# secrets
.env

# Audio and transcripts live in the Obsidian vault, never here
*.wav
*.mp3
*.m4a
*.flac

# watch.py drop folders - contents are transient, never committed
/Inbox/*
!/Inbox/process-inbox.sh
/Converted/
/Failed/
.pipeline.lock
